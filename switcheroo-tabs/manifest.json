{
  "manifest_version": 3,
  "name": "Switcheroo Tabs",
  "version": "1.0",
  "description": "Brings Switcheroo HQ forward when you and Claude talk, and your video back when it plays on.",
  "background": {
    "service_worker": "bg.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": [
    "storage"
  ]
}